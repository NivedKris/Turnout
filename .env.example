# Copy to .env (local) and add the same keys in Vercel → Project → Settings → Environment Variables.

# MongoDB Atlas connection string. Atlas → Network Access must allow 0.0.0.0/0 for Vercel.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (optional, default "turnout")
MONGODB_DB=turnout

# Copilot provider chain, tried in order on error/rate-limit (default: groq,google)
LLM_PROVIDERS=groq,google
# Optional model override for the first provider
LLM_MODEL=
# Groq API key (primary copilot provider): https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio key. GEMINI_API_KEY is also accepted as an alias.
GOOGLE_GENERATIVE_AI_API_KEY=
# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Protects POST /api/admin/seed and /api/admin/reset (min 12 chars)
ADMIN_TOKEN=
# Shared passcode gate for the demo (min 4 chars). Leave empty to disable the gate.
APP_PASSCODE=
