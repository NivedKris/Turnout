# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/paper
# next.js
/.next/
/out/
/docs
# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local
*.local

slides/*.aux
slides/*.log
slides/*.fls
slides/*.fdb_latexmk
slides/*.xdv
slides/turnout-slides.pdf

# Working material kept locally (README.pdf and the slides are the published versions)
/docs/
/paper/
